<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this theme only covers the window before the first frame. -->
    <style name="Theme.BoloHisab" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <!--
      Android 12+ builds this automatically from the launcher icon, but most of this app's
      target phones are older, where the OS would otherwise just show a blank window until
      the first frame. This gives every API level the same branded launch.
    -->
    <style name="Theme.BoloHisab.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/brand</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.BoloHisab</item>
    </style>
</resources>
